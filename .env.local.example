# Copy this file to .env.local and fill in real values.
# Supabase and Paddle each have separate sandbox/dev and production
# projects/accounts - use dev keys locally, never live keys.

# --- Supabase (Auth + Postgres) -------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key - server-only, never exposed to the browser. Used only by
# src/lib/supabase/admin.ts to apply verified Paddle webhook events.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth is configured in the Supabase dashboard (Authentication ->
# Providers -> Google), using a Google Cloud OAuth client's Client ID/Secret
# - there's nothing to set here in .env.local for it.

# --- Paddle (Merchant of Record for the subscription) ---------------------
# sandbox and live are SEPARATE Paddle accounts (separate keys, catalog,
# dashboards). Use sandbox everywhere until you're ready to charge real cards.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Price id (pri_...) for the monthly subscription, from Paddle > Catalog.
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=

# --- Site ------------------------------------------------------------------
# Your production URL (no trailing slash) - e.g. the Vercel domain
# https://<project>.vercel.app, or your custom domain. Shown to Android app
# users when pointing them to subscribe on the website - see src/lib/platform.ts
# for why the Android build doesn't sell the subscription itself.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
